# Copie este arquivo para .env e ajuste conforme o ambiente.
# Este arquivo (valores de exemplo) é versionado; o .env real NÃO vai ao repositório.

CI_ENVIRONMENT = development

app.baseURL = 'http://localhost:8080/'

database.default.hostname = db
database.default.database = aassc
database.default.username = aassc
database.default.password = aassc
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
