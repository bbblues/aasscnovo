# ===========================================================================
# AASSC — Configuração de PRODUÇÃO (exemplo).
# ---------------------------------------------------------------------------
# Copie para `.env` na VPS (raiz do projeto) e preencha com valores reais.
# O `.env` NÃO é versionado (ver .gitignore). Nunca commit segredos.
# ===========================================================================

# ---- Aplicação (CodeIgniter 4) ----
CI_ENVIRONMENT = production

app.baseURL = 'https://sis.aassc.com.br/'

# (Opcional) Defesa em profundidade: exige HTTPS na aplicação e envia HSTS.
# Requer proxy confiável (app.proxyIPs já cobre a rede Docker). Por padrão o
# redirect 80->443 já é feito pelo Nginx, então deixe comentado se preferir.
# app.forceGlobalSecureRequests = true

# ---- Banco de dados (MariaDB em container — decisão D6, opção A) ----
database.default.hostname = db
database.default.database = aassc
database.default.username = aassc
database.default.password = 'COLOQUE_AQUI_UMA_SENHA_FORTE'
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

# ---- Credenciais do container MariaDB (usadas pelo serviço "db") ----
# MARIADB_USER/MARIADB_PASSWORD devem ser iguais a database.default.username
# e database.default.password para o aplicativo acessar o banco.
MARIADB_DATABASE = aassc
MARIADB_USER = aassc
MARIADB_PASSWORD = 'COLOQUE_AQUI_UMA_SENHA_FORTE'
MARIADB_ROOT_PASSWORD = 'COLOQUE_AQUI_UMA_SENHA_ROOT_FORTE'
